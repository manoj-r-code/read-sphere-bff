{
    "name": "read-sphere-bff",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": ">=16.9.1",
        "npm": ">=7.21.1"
    },
    "scripts": {
        "start": "NODE_ENV=production node ./bin/www",
        "dev": "NODE_ENV=development nodemon ./bin/www",
        "test": "npm run lint:check && npm run format:check && npm run test:cases",
        "test:cases": "set NODE_ENV=test && nyc mocha \"'{,!(node_modules)/**}/*.spec.js'\" --timeout 10000 --exit",
        "format": "prettier --write \"**/*.js\"",
        "format:check": "prettier --check \"**/*.js\"",
        "lint": "eslint --fix . --ignore-path .gitignore",
        "lint:check": "eslint . --ignore-path .gitignore"
    },
    "dependencies": {
        "@sentry/node": "6.12.0",
        "@sentry/tracing": "6.12.0",
        "bluebird": "^3.7.2",
        "body-parser": "1.20.2",
        "cors": "2.8.5",
        "dotenv": "10.0.0",
        "express": "4.19.2",
        "got": "11.8.5",
        "jsonwebtoken": "^9.0.0",
        "jwks-rsa": "^2.0.5",
        "mongoose": "6.12.9",
        "morgan": "1.10.0",
        "node-fetch": "^3.3.2",
        "prom-client": "13.2.0",
        "redis": "^4.0.1"
    },
    "devDependencies": {
        "chai": "4.3.4",
        "chai-http": "4.3.0",
        "eslint": "7.32.0",
        "eslint-config-airbnb-base": "14.2.1",
        "eslint-config-prettier": "8.3.0",
        "eslint-plugin-import": "2.24.2",
        "eslint-plugin-jsdoc": "36.1.0",
        "eslint-plugin-prettier": "4.0.0",
        "mocha": "9.2.2",
        "nodemon": "^3.1.2",
        "nyc": "15.1.0",
        "prettier": "2.4.0",
        "sinon": "11.1.2"
    }
}
